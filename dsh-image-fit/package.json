{
  "name": "dsh-image-fit",
  "version": "0.1.0",
  "description": "让 DSH 右侧预览里的图片等比缩放到面板内（DSH 默认按原尺寸显示，大图需要滚动才能看全）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "^18.2.0"
  },
  "license": "MIT"
}
