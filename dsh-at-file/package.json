{
  "name": "dsh-at-file",
  "version": "0.1.0",
  "description": "@文件 选择附加 —— 输入框输入 @ 弹出工作区文件选择器，选中后文件内容随消息发送给 Agent —— 本地永久插件",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "react": "^18.2.0"
  },
  "license": "MIT"
}
